# EMBER & OAK — Environment Variables Template
# Copy this file to .env.local and populate with your production or tunnel credentials.

# n8n Automation Webhook Endpoints
# Point these to your public HTTPS n8n instance or Cloudflare/ngrok tunnel
N8N_RESERVATION_WEBHOOK_URL=
N8N_CONTACT_WEBHOOK_URL=
N8N_EVENT_WEBHOOK_URL=
N8N_FAQ_WEBHOOK_URL=

# Google Gemini API (For direct AI FAQ Concierge fallback)
GEMINI_API_KEY=
